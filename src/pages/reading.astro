---
import Navigation from '../components/Navigation.astro';
import Layout from '../layouts/Layout.astro';
import Book from '../components/Book.astro';
import { books } from '../info/books';
---

<Layout>
  <Navigation />
  <div class="body-container">
    <div class="reading-about">
      <h1 class="animate__animated animate__fadeInDown">Reading</h1>
      <p class="animate__animated animate__fadeInUp">
        Collection of my favourite pieces of manga and literature.
      </p>
      <br />
    </div>
    <div class="reading-container">
      {
        books.map((book) => (
          <Book
            bookAuthor={book.bookAuthor}
            bookName={book.bookName}
            bookStatus={book.bookStatus}
            bookLink={book.bookLink}
          />
        ))
      }
    </div>
  </div>

  <style>
    .body-container {
      color: var(--body);
      display: flex;
      flex-flow: column;
      margin: 0 auto;
      max-width: 650px;
      width: 100%;
    }
    .reading-about {
      margin-bottom: 50px;
    }
    .reading-container {
      margin-bottom: 30px;
    }
    h1 {
      font-family: var(--header-font);
      font-size: 2.5rem;
      margin-bottom: 28px;
    }
    p {
      font-size: 1.1rem;
      line-height: 1.75em;
    }

    @media (max-width: 673px) {
      .body-container {
        padding: 0 10px;
      }
    }

    @media (max-width: 490px) {
      h1 {
        font-size: 2rem;
      }

      p {
        font-size: 1rem;
      }
    }
  </style>
</Layout>
