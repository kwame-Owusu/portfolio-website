---
import Navigation from '../components/Navigation.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <Navigation />
  <div class="body-container">
    <div class="page-header">
      <h1 class="animate__animated animate__fadeInDown">Now</h1>
      <p class="animate__animated animate__fadeInUp">
        A snapshot of what I'm focused on at the moment: work, what I'm
        building, training and life, my overall direction. Following suit from <a
          href="https://sive.rs/now"
          class="link"
          target="_blank">Derek Sivers' now page</a
        >.
      </p>
    </div>
    <ul class="now-list animate__animated animate__fadeInUp">
      <li>
        <span class="list-label">Becoming a better software engineer</span>
      </li>
      <li>
        <span class="list-label"
          >Contributing to open source projects, mainly <a
            class="link"
            href="https://github.com/8thpark/geode">Geode</a
          ></span
        >
      </li>
      <li>
        <span class="list-label"
          >Learning how to use agents whilst preserving my programming ability
          and sanity</span
        >
      </li>
      <li>
        <span class="list-label">
          I am really interested in getting into one of these startups springing
          up in London and work as a product engineer. I'm interested in 
          <a class="link" href="https://www.plain.com/"> plain, </a>
          <a class="link" href="https://www.granola.ai/"> granola, </a>
          <a class="link" href="https://incident.io/">incident.io </a> and
          <a class="link" href="https://attio.com/"> attio</a> right now
        </span>
      </li>
      <li>
        <span class="list-label"
          >Making serious gains in the gym, I'm able to bench 82.5kg for 8 reps
          now amongst other serious lifts :)</span
        >
      </li>
      <li>
        <span class="list-label"
          >My time at <a class="link" href="https://zing.dev/">zing</a> has come to
          an end, after an amazing 13 months</span
        >
      </li>
      <li>
        <span class="list-label"
          >Going back to uni, to finish the final year of my bachelors degree in
          software engineering</span
        >
      </li>
    </ul>
  </div>
</Layout>

<style>
  .body-container {
    color: var(--body);
    display: flex;
    flex-flow: column;
    margin: 0 auto;
    max-width: 650px;
    width: 100%;
  }

  .page-header {
    margin-bottom: 50px;
  }

  h1 {
    font-family: var(--header-font);
    font-size: 2.5rem;
    margin-bottom: 28px;
  }

  p {
    font-size: 1.1rem;
    line-height: 1.75em;
  }

  a.link {
    text-decoration: none;
    color: white;
    position: relative;
    display: inline;
  }

  a.link::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--grey-600);
    transition: height 0.23s ease;
  }

  a.link:hover::before {
    height: 100%;
    background-color: var(--grey-600);
    z-index: -1;
  }

  .now-list {
    list-style: circle;
    padding: 0;
    margin-left: 2rem;
  }

  .now-list li {
    font-size: 1.1rem;
    line-height: 1.75em;
    padding: 12px 0;
    border-bottom: 1px solid var(--highlight);
  }

  .now-list li:last-child {
    border-bottom: none;
  }

  .list-label {
    color: var(--body);
  }

  @media (max-width: 673px) {
    .now-list {
      margin-left: 10px;
      margin-right: 10px;
    }
  }

  @media (max-width: 490px) {
    h1 {
      font-size: 2rem;
    }

    p {
      font-size: 1rem;
    }

    .now-list li {
      font-size: 1rem;
    }
  }
</style>
