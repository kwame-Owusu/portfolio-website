---
interface Props {
  bookName: string;
  bookStatus: 'Reading' | 'To Read' | 'Read';
  bookAuthor: string;
  bookLink: string;
}
const { bookAuthor, bookName, bookStatus, bookLink } = Astro.props;
---

<div class="book-row">
  <a href={bookLink} target="_blank" rel="noopener noreferrer">
    <span class="book-name">{bookName}</span>
    <svg
      class="arrow"
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="7" y1="17" x2="17" y2="7"></line>
      <polyline points="7 7 17 7 17 17"></polyline>
    </svg>
  </a>
  <span class="book-author">{bookAuthor}</span>
  <span class="book-status-badge" data-status={bookStatus}>{bookStatus}</span>
</div>

<style>
  .book-row {
    padding: 16px 18px;
    justify-content: space-between;
    display: flex;
    align-items: center;
    gap: 24px;
    border-radius: 8px;
    transition: background-color 0.25s ease-in-out;
  }

  .book-row:hover {
    background-color: var(--bg-alt);
  }

  .book-row a {
    color: var(--white);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .book-name {
    font-size: 1rem;
    opacity: 0.9;
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .book-author {
    color: var(--subtext);
    font-size: 0.85rem;
    flex: 1;
  }

  .book-row:hover .arrow {
    transform: translate(5px, -4px);
  }

  .arrow {
    color: var(--subtext);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .book-status-badge {
    font-size: 0.7rem;
    font-weight: 600;
    opacity: 0.4;
    padding: 2px 8px;
    border-radius: 4px;
    flex-shrink: 0;
    letter-spacing: 0.3px;
    text-transform: uppercase;
  }

  .book-status-badge[data-status='Reading'] {
    background-color: #efdcab;
    color: #333;
  }

  .book-status-badge[data-status='Read'] {
    background-color: #c7db9c;
    color: #333;
  }

  .book-status-badge[data-status='To Read'] {
    background-color: #fdab9e;
    color: #333;
  }

  @media (max-width: 600px) {
    .book-row {
      gap: 12px;
      padding: 12px 14px;
    }

    .book-name {
      max-width: 160px;
      font-size: 0.9rem;
    }

    .book-author {
      font-size: 0.75rem;
    }
  }
</style>
