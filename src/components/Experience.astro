---
interface Props {
  expLink: string;
  expLogo: string;
  expCompany: string;
  expRole: string;
  expYear: string;
}

const { expLink, expLogo, expCompany, expRole, expYear } = Astro.props;
---

<div class="experience-row">
  <img src={expLogo} alt={`${expCompany} logo`} class="exp-icon" />
  <span class="exp-role">{expRole}</span>
  <a href={expLink} target="_blank" class="exp-company">{expCompany}</a>
  <span class="exp-year">{expYear}</span>
</div>

<style>
  .experience-row {
    padding: 16px 18px;
    justify-content: space-between;
    display: flex;
    align-items: center;
    gap: 12px;
    border-radius: 8px;
    transition: background-color 0.25s ease-in-out;
  }

  .experience-row:hover {
    background-color: var(--bg-alt);
  }

  .exp-icon {
    height: 28px;
    width: 28px;
    border-radius: 6px;
    flex-shrink: 0;
    object-fit: cover;
  }

  .exp-role {
    color: var(--subtext);
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .exp-company {
    color: var(--white);
    opacity: 0.7;
    font-weight: bold;
    text-decoration: none;
    font-size: 1rem;
  }

  .exp-year {
    color: var(--subtext);
    font-size: 0.8rem;
    flex-shrink: 0;
    letter-spacing: 0.3px;
    margin-left: auto;
  }
</style>
