---
interface Props {
  projectName: string;
  projectDesc: string;
  projectLink: string;
}
const { projectName, projectDesc, projectLink } = Astro.props;
---

<div class="project-container">
  <div class="project-item">
    <a href={projectLink} target="_blank">
      <span class="project-name">{projectName}</span>
      <svg
        class="arrow"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="7" y1="17" x2="17" y2="7"></line>
        <polyline points="7 7 17 7 17 17"></polyline>
      </svg>
    </a>
    <p>{projectDesc}</p>
  </div>
</div>

<style>
  .project-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .project-container p {
    color: var(--subtext);
  }

  .project-item {
    margin: 0;
    opacity: 0.5;
    padding: 16px 18px;
    justify-content: space-between;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--highlight);
    gap: 24px;
    border-radius: 8px;
    transition:
      opacity 0.25s ease-in-out,
      margin 0.25s ease-in-out,
      background-color 0.25s ease-in-out,
      border-color 0.25s ease-in-out,
      border-radius 0.25s ease-in-out;
  }

  .project-item a {
    color: var(--white);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .project-name {
    font-weight: bold;
    position: relative;
  }

  .project-name::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1.5px;
    background-color: var(--white);
    transition: width 0.25s ease-in-out;
  }

  .project-item:hover .project-name::after {
    width: 100%;
  }

  .project-item:hover {
    margin-left: 10px;
    margin-right: 10px;
    opacity: 1;
    background-color: var(--bg-alt);
    border-bottom-color: var(--grey-600);
  }

  .project-item:hover .arrow {
    transform: translate(4px, -3px);
  }

  .arrow {
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
</style>
