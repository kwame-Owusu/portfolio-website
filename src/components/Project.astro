---
interface Props {
  projectName: string;
  projectDesc: string;
  projectLink: string;
  isContributor?: boolean;
}
const { projectName, projectDesc, projectLink, isContributor } = Astro.props;
---

<div class="project-card">
  <a href={projectLink} target="_blank">
    <div class="card-header">
      <span class="project-name">
        {projectName}
        {isContributor && <span class="badge">contributor</span>}
      </span>
      <svg
        class="arrow"
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="7" y1="17" x2="17" y2="7"></line>
        <polyline points="7 7 17 7 17 17"></polyline>
      </svg>
    </div>
    <p class="project-desc">{projectDesc}</p>
  </a>
</div>

<style>
  .project-card {
    border: 1px solid var(--highlight);
    border-radius: 10px;
    padding: 20px;
    transition:
      transform 0.25s ease-in-out,
      border-color 0.25s ease-in-out;
  }

  .project-card:hover {
    border-color: var(--grey-600);
  }

  .project-card a {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .project-name {
    color: var(--white);
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .badge {
    font-size: 0.7rem;
    color: var(--subtext);
    background: var(--grey-700);
    padding: 2px 8px;
    border-radius: 6px;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .project-desc {
    color: var(--subtext);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }

  .arrow {
    color: var(--subtext);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    flex-shrink: 0;
    width: 16px;
    height: 16px;
  }

  .project-card:hover .arrow {
    transform: translate(5px, -4px);
  }
</style>
